# ──────────────────────────────────────────────
# Large video demonstration files
# ──────────────────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.webm
*.flv
*.m4v

# ──────────────────────────────────────────────
# Large raw photos (demos folder)
# ──────────────────────────────────────────────
Real\ Robot\ Demonstrations/*.jpg
Real\ Robot\ Demonstrations/*.jpeg
Real\ Robot\ Demonstrations/*.png
Simulation\ Robot\ Demonstrations/*.jpg
Simulation\ Robot\ Demonstrations/*.jpeg

# ──────────────────────────────────────────────
# OS / Editor
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# Exceptions — keep key documentation images
# ──────────────────────────────────────────────
!Hexapod_real_and_sim.png
!Simulation\ Robot\ Demonstrations/*.png
!Real\ Robot\ Demonstrations/Hexapod1.jpg
